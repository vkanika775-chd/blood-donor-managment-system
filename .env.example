# BloodLink India — Server Environment Configuration
PORT=3000
NODE_ENV=development

# e-RaktKosh Integration (Official MoHFW / C-DAC Platform)
# Official e-RaktKosh API credentials require an institutional MoU with MoHFW / C-DAC.
# When provided, the backend will query live stock feeds from the official endpoint.
# When blank, the system displays official verification links to eraktkosh.mohfw.gov.in.
ERAKTKOSH_API_KEY=
ERAKTKOSH_CLIENT_ID=
ERAKTKOSH_API_BASE_URL=https://eraktkosh.mohfw.gov.in/BLDA/api

# Open Government Data (data.gov.in) API Key
# Sign up at https://data.gov.in/ to generate an API key for live dataset sync.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=

# Geocoding & OpenStreetMap Nominatim Service
MAP_GEOCODE_USER_AGENT=BloodLinkIndia-HealthPlatform/1.0 (contact@bloodlink.in)
GEOCODE_CACHE_HOURS=24

# Caching & Security
API_CACHE_MINUTES=30
APP_SECRET=bloodlink_india_secret_2026_nbtc
